# Slack bot token (xoxb-...) with the chat:write scope.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Target channel: ID (recommended, e.g. C0123456789) or #channel-name.
SLACK_CHANNEL=C0123456789

# Label identifying this host in notifications. Defaults to the container hostname.
NODE_NAME=

# De-duplication window for repeated identical container+action events.
EVENT_COOLDOWN=30s

# Extra container "die" exit codes to ignore (comma-separated). 0 is always ignored.
# Add 143 (SIGTERM) and/or 137 (SIGKILL) to silence redeploy/stop noise.
IGNORE_EXIT_CODES=0
