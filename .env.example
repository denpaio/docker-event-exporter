# Slack bot token (xoxb-...) with the chat:write scope.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Target channel: ID (recommended, e.g. C0123456789) or #channel-name.
SLACK_CHANNEL=C0123456789

# Label identifying this host in notifications. Defaults to the container hostname.
NODE_NAME=

# De-duplication window for repeated identical container+action events.
EVENT_COOLDOWN=30s

# A "die" within this window after a stop signal (Ctrl-C, docker stop / compose
# down) is treated as an intentional stop, not a crash. Set above your longest
# stop_grace_period; set to 0 to disable and notify on every non-zero exit.
STOP_GRACE=30s

# Extra container "die" exit codes to ignore (comma-separated). 0 is always
# ignored. For containers that exit non-zero on their own for a benign reason;
# intentional stops are already handled by STOP_GRACE above.
IGNORE_EXIT_CODES=0
